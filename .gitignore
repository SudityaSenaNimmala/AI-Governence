node_modules/
dist/
build/
# Exception: Electron desktop agent build (served by the download endpoint).
# Windows binaries that can't be built on the Linux deploy server.
!agent/build/
!agent/build/electron-dist/
!agent/build/electron-dist/**
*.log
.DS_Store
Thumbs.db
.env
.env.local
*.sqlite
*.sqlite-journal
server/data/*.db
agent/out/
.vite/
.cache/
coverage/
agent/electron/node_modules/
agent/electron/package-lock.json
agent/browser-extension/Untitled
.claude/settings.local.json
agent/installer/*.exe
agent/installer/build/
# Staged Claude Usage Tracker binary (~85 MB). scripts/deploy.mjs builds it and
# copies it here so the deploy tar can ship it — build/ is excluded from both the
# tar and .dockerignore, which is why it cannot live there. It is a build output,
# rebuilt on every deploy, and must never be committed.
agent/prebuilt/

# Extension signing key (stable ID) — never commit the private key
.deploy-keys/

# Baked pilot config (contains enroll secret) — never commit
browser-extension/cfai-config.json

# CRX signing key. The extension ID is derived from it, so committing it would let
# anyone sign a package that every managed machine accepts as ours.
*.pem
crx-signing-key*

# Auto-triage context bundles. Generated from live error rows: masked, but
# still production error text plus source excerpts, and regenerable on demand.
# Nothing here belongs in the repo.
.triage/

# Local backup of a production connection string. Must never be committed.
server/.env.bak-prod-db
*.bak-prod-db
