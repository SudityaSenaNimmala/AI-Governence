# Copy to .env (git-ignored) and fill in before deploying.

# REQUIRED — JWT signing secret for the server's machine auth.
JWT_SECRET=change-me-to-a-long-random-string

# Gates admin-only dashboard routes (Session Replay playback, etc.). Optional
# here — scripts/deploy.mjs auto-generates this directly in the SERVER's own
# .env on first deploy if it's missing, and never overwrites an existing
# value. Set it explicitly only if you want to choose the value yourself.
# ADMIN_TOKEN=

# Storage: the server's DAL is MongoDB-only. Leave unset to use the bundled
# mongo container (mongodb://mongo:27017/aigov), or point at an external Mongo:
# MONGODB_URI=mongodb+srv://user:pass@cluster/aigov

# ---- deploy target (used by `npm run deploy`) ----
# REQUIRED for deploy — the remote Docker host, as user@host.
DEPLOY_SSH=root@165.22.223.59
# SSH key for the host (default: ~/.ssh/ai_gov_deploy)
# DEPLOY_KEY=~/.ssh/ai_gov_deploy
# Remote project dir (default: /opt/ai-gov)
# DEPLOY_DIR=/opt/ai-gov
