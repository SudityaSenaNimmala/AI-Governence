# ── Feature Flags ─────────────────────────────────────────────────────────────
# Every VITE_FEAT_* defaults to true when absent. Set to "false" to disable.
# Vite inlines these at build time — changes need a rebuild to take effect.
#
# VITE_FEAT_OVERVIEW=true
# VITE_FEAT_AI_SYSTEMS=true
# VITE_FEAT_AGENTS_MCP=true
# VITE_FEAT_DLP=true
# VITE_FEAT_CLAUDE_USAGE=true
# VITE_FEAT_POLICIES=true
# VITE_FEAT_RISK_SCORES=true
# VITE_FEAT_ACCESS_REQUESTS=true
# VITE_FEAT_AGENT_GOVERNANCE=true
# VITE_FEAT_INSTALLATIONS=true
# VITE_FEAT_INTEGRATIONS=true
# VITE_FEAT_SERVER_MONITOR=true
# VITE_FEAT_SDK=true
#
# Dependencies:
#   risk_scores → ai_systems (shows a warning banner when ai_systems is off)
