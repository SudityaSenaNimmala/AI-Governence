# ── Feature Flags ─────────────────────────────────────────────────────────────
# Every VITE_FEAT_* defaults to true when absent. Set to "false" to disable.
# Vite inlines these at build time — changes need a rebuild to take effect.
#
# VITE_FEAT_OVERVIEW=true
# VITE_FEAT_AI_SYSTEMS=true
# VITE_FEAT_AGENTS_MCP=true
# VITE_FEAT_DLP=true
# VITE_FEAT_CLAUDE_USAGE=true
# VITE_FEAT_POLICIES=true
# VITE_FEAT_RISK_SCORES=true
# VITE_FEAT_ACCESS_REQUESTS=true
# VITE_FEAT_AGENT_GOVERNANCE=true
# VITE_FEAT_INSTALLATIONS=true
# VITE_FEAT_INTEGRATIONS=true
# VITE_FEAT_SERVER_MONITOR=true
# VITE_FEAT_SDK=true
#
# Dependencies:
#   risk_scores → ai_systems (shows a warning banner when ai_systems is off)

# ── Deployment mode ───────────────────────────────────────────────────────────
# Standalone means "no CloudFuze platform behind this build", which is the
# default. The standalone host serves no /cfcommon/api backend, so calls through
# helpers/apiRequest.js are skipped instead of fired-and-404'd.
# Set to "false" only for a build served behind the platform.
#
# VITE_STANDALONE=true

# ── Admin credential (optional, LOCAL DEV ONLY) ───────────────────────────────
# Matches the server's ADMIN_TOKEN and unlocks the requireAdminAuth routes
# (/access-requests, replay, SDK projects). With it unset no Authorization
# header is sent and those views degrade to their "needs a credential" state.
#
# DO NOT SET THIS FOR A PUBLIC BUILD. Vite inlines import.meta.env.* into the
# JS bundle, which is world-readable — setting it publishes an admin bearer
# token to every visitor of the site.
#
# VITE_ADMIN_TOKEN=dev-admin-token
