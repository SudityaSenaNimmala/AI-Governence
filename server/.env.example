# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit .env — it contains secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Get this from the Atlas dashboard or ask the
# project owner.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cloudfuze?retryWrites=true&w=majority&appName=AG

# AES-256 key used to encrypt sensitive fields at rest (32-byte hex string).
# Must be the same across all server instances. Ask the project owner.
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
PORT=8787

# ── Feature flags ─────────────────────────────────────────────────────────────
# One toggle per feature — controls dashboard + extension + agent.
# All default to true. Set =false to disable.
FEAT_OVERVIEW=true
FEAT_AI_SYSTEMS=true          # AI Systems tab + platform blocking (extension)
FEAT_AGENTS_MCP=true          # Agents & MCP tab + MCP/agent discovery (agent)
FEAT_DLP=true                 # DLP tab + scanning + guardrails (extension)
FEAT_CLAUDE_USAGE=true
FEAT_POLICIES=true
FEAT_RISK_SCORES=true
FEAT_ACCESS_REQUESTS=true     # Access Requests tab + access gate (extension)
FEAT_AGENT_GOVERNANCE=true
FEAT_INSTALLATIONS=true
FEAT_INTEGRATIONS=true
FEAT_SERVER_MONITOR=true
FEAT_SDK=true
FEAT_SESSION_REPLAY=false     # Sessions tab + rrweb recording (extension)
FEAT_MODEL_ROUTING=true       # Model routing tab + enforcement (extension)
FEAT_ENDPOINT_SCAN=true       # AI tool scanning (agent)
FEAT_CLIPBOARD_MONITOR=true   # Clipboard & prompt monitoring (agent)

# Signs the self-hosted browser-extension package (/api/v1/extension/*), so the
# server can build and serve it without anyone copying a 23 MB binary to the host.
#
# THE EXTENSION ID IS DERIVED FROM THIS KEY, and every managed machine's
# force-install policy names that ID. It is therefore NOT rotatable — changing it
# orphans every deployed policy. Back it up wherever you keep production secrets.
#
# Generate: node scripts/pack-crx.mjs --url https://<your host>
#           (writes dist/extension/crx-signing-key.pem on first run)
# Encode:   base64 -w0 dist/extension/crx-signing-key.pem
#
# One line, base64 — a PEM's newlines do not survive .env substitution, and a
# truncated key builds a package that installs nowhere without reporting anything.
CRX_SIGNING_KEY=
