{
  "name": "cloudfuze-ai-governance",
  "version": "0.1.0",
  "description": "CloudFuze AI Governance — Desktop Agent",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.cloudfuze.ai-governance",
    "productName": "CloudFuze AI Governance",
    "copyright": "Copyright © 2026 CloudFuze",
    "directories": {
      "output": "../build/electron-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "agent/src",
        "filter": ["**/*", "!**/node_modules/**"]
      },
      {
        "from": "../node_modules",
        "to": "agent/node_modules"
      },
      {
        "from": "../package.json",
        "to": "agent/package.json"
      },
      {
        "from": "monitor-runner.mjs",
        "to": "agent/electron/monitor-runner.mjs"
      },
      {
        "from": "../../browser-extension",
        "to": "browser-extension",
        "filter": ["**/*", "!**/node_modules/**"]
      },
      {
        "from": "preload.js",
        "to": "electron/preload.js"
      },
      {
        "from": "renderer",
        "to": "electron/renderer",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "dir", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets",
      "category": "Utility"
    }
  }
}
